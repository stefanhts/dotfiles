[user]
	name = Stefan Heller
	email = stefan.heller@okta.com
	signingkey = 7082120B4788575A
[core]
    editor = nvim
	excludesfile = /Users/stefan.heller/.gitignore
	sshCommand = /usr/local/bin/ocm handler ssh
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[alias]
    what = diff --cached
    oneline = log --oneline
    up = !git pull origin $(git remote show origin | grep 'HEAD branch' | awk '{print $NF}') --rebase
    br = !git branch | fzf | xargs git checkout
    pushf = !git push -u origin $(git rev-parse --abbrev-ref HEAD) --force-with-lease
[credential]
	useHttpPath = true
	helper = /usr/local/bin/ocm handler https
[commit]
	gpgsign = true
[gpg]
	program = /opt/homebrew/bin/gpg
[http]
	postBuffer = 157286400
[url "https://github.com/"]
	insteadOf = org-133040856@github.com:
